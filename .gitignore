# Publish only the reviewed source, configuration, documents and artwork.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Configuration/
!/Configuration/**
!/Shared/
!/Shared/**
!/SnapSchedule/
!/SnapSchedule/**
!/SnapScheduleWidget/
!/SnapScheduleWidget/**
!/SnapScheduleTests/
!/SnapScheduleTests/**
!/SnapScheduleUITests/
!/SnapScheduleUITests/**
!/SnapSchedule.xcodeproj/
!/SnapSchedule.xcodeproj/**
!/docs/
/docs/*
!/docs/ARCHITECTURE.md
!/docs/SCREENSHOTS.md
!/docs/PUBLICATION.md
!/docs/images/
!/docs/images/**

# Local state, signing material, private configuration and generated outputs.
**/.DS_Store
**/xcuserdata/
**/*.xcuserstate
**/.env
**/.env.*
**/*.private.*
**/*Private.xcconfig
**/*Local.xcconfig
**/*.p12
**/*.p8
**/*.pfx
**/*.pem
**/*.key
**/*.cer
**/*.mobileprovision
**/*.provisionprofile
**/*.ipa
**/*.xcarchive/
**/*.xcresult/
**/DerivedData/
**/SourcePackages/
**/*.sqlite*
**/*.db
**/*.log
**/node_modules/
**/.openai/

# Additional private identities and distribution diagnostics.
**/*.keystore
**/*.jks
**/*.der
**/*.trace/
**/*.dSYM/
**/Secrets.xcconfig
**/secrets.*
**/ExportOptions*.plist
**/*UploadOptions.plist
**/*ExportOptions.plist
**/*.mp4
**/*.mov
