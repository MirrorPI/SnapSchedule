    },
    " %lld Calendar copies could not be added; the internal schedules remain saved. Retry from schedule details.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld Apple Calendar copies could not be added; the internal schedules remain saved. Retry from schedule details."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld Apple Calendar copy could not be added; the internal schedule remains saved. Retry from schedule details."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Apple 캘린더 사본 %lld개를 추가할 수 없지만 앱 내 일정은 저장되어 있습니다. 일정 상세에서 다시 시도해 주세요."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Appleカレンダーに%lld件のコピーを追加できませんでしたが、アプリ内の予定は保存されています。予定の詳細から再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    " %lld Calendar copies were added.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld Apple Calendar copies were added."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld Apple Calendar copy was added."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Apple 캘린더 사본 %lld개를 추가했습니다."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Appleカレンダーに%lld件のコピーを追加しました。"
                }
              }
            }
          }
        }
      }
    },
    " %lld distant reminders are waiting for a future app activation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld distant reminders are waiting for a future app activation."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld distant reminder is waiting for a future app activation."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " 먼 날짜의 알림 %lld개는 다음 앱 활성화를 기다립니다."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " 先の日付の通知%lld件は、次にアプリがアクティブになるまで待機します。"
                }
              }
            }
          }
        }
      }
    },
    " %lld reminders could not be scheduled and will be retried.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld reminders could not be scheduled and will be retried."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld reminder could not be scheduled and will be retried."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " 알림 %lld개를 예약할 수 없습니다. 다시 시도합니다."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld件の通知を予約できませんでした。再試行します。"
                }
              }
            }
          }
        }
      }
    },
    " Calendar completion is unknown for %lld copies; review schedule details before retrying to avoid duplicates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Apple Calendar completion is unknown for %lld copies; review schedule details before retrying to avoid duplicates."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Apple Calendar completion is unknown for %lld copy; review schedule details before retrying to avoid duplicates."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Apple 캘린더 사본 %lld개의 추가 결과를 알 수 없습니다. 중복을 피하려면 재시도 전에 일정 상세를 확인해 주세요."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " Appleカレンダーのコピー%lld件の追加結果は不明です。重複を避けるため、再試行前に予定の詳細を確認してください。"
                }
              }
            }
          }
        }
      }
    },
    " Calendar copies could not be checked and will be retried when the app becomes active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Apple Calendar copies could not be checked and will be retried when the app becomes active."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " Apple 캘린더 사본을 확인할 수 없습니다. 앱이 활성화되면 다시 시도합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " Appleカレンダーのコピーを確認できませんでした。アプリがアクティブになると再試行します。"
          }
        }
      }
    },
    " Notification access is %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Notification access is %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 알림 접근 상태: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 通知のアクセス状態：%@。"
          }
        }
      }
    },
    " Notification access is denied; the schedules remain saved. You can enable it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Notification access is denied; the schedules remain saved. You can enable it in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 알림 접근이 거부되었지만 일정은 저장되어 있습니다. 설정에서 허용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 通知へのアクセスは拒否されていますが、予定は保存されています。設定で許可できます。"
          }
        }
      }
    },
    " Notification permission could not be checked or requested (%@). Review it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Notification permission could not be checked or requested (%@). Review it in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 알림 권한을 확인하거나 요청할 수 없습니다(%@). 설정에서 확인해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 通知の許可を確認またはリクエストできませんでした（%@）。設定で確認してください。"
          }
        }
      }
    },
    " Notification permission is still %@. Review it in Settings.": {
      "extractionState": "manual",
      "localizations": {
