          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "일정은 저장되어 있습니다. 먼 날짜의 알림 %lld개는 다음 앱 활성화로 예약 공간이 생기면 예약합니다."
