          "stringUnit": {
            "state": "translated",
            "value": "The original may have been deleted, removed from limited access, or made unavailable by Photos permission changes. Your unregistered and registered schedules are kept."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본이 삭제되었거나 제한적 접근에서 제외되었거나 사진 권한 변경으로 사용할 수 없을 수 있습니다. 저장된 미등록 일정과 등록된 일정은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像が削除された、制限付きアクセスから外された、または写真の許可変更により利用できなくなった可能性があります。未登録・登録済みの予定は保存されています。"
          }
        }
      }
    },
    "The schedule date, time, or time zone is invalid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule date, time, or time zone is invalid."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정의 날짜·시간·시간대가 유효하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の日付・時刻・タイムゾーンが無効です。"
          }
