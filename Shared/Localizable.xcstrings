          }
        }
      }
    },
    "The schedules could not be saved. No candidates were registered. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration could not be saved. The unregistered schedules and saved edits are kept. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록 내용을 저장하지 못했습니다. 미등록 일정과 저장된 수정 내용은 유지됩니다. 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録内容を保存できませんでした。未登録の予定と保存済みの変更は残っています。もう一度お試しください。"
          }
        }
      }
    },
    "The selected %lld candidates are now registered.": {
